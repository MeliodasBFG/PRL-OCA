# ============================================================================
# PRL-OCA 3D ONLINE - Ejemplo de Variables de Entorno
# ============================================================================
# Copia este archivo como `.env` en `apps/web/.env` para desarrollo local,
# o configura estas variables en el panel de Cloudflare Pages.
# ¡NUNCA subas claves secretas reales al repositorio Git!

# URL HTTP del Worker de Cloudflare para llamadas REST API
VITE_API_URL=http://localhost:8787

# URL WebSocket del Worker de Cloudflare para sincronización en tiempo real
VITE_WS_URL=ws://localhost:8787

# Modo demostración / offline (permite probar sin servidor externo si el Worker no está activo)
VITE_ENABLE_LOCAL_FALLBACK=true
